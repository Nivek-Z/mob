{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mob",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-02",
  "workers_dev": true,
  "preview_urls": true,
  "build": {
    "command": "node scripts/build.mjs"
  },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "mob-media"
    }
  ],
  "vars": {
    "APP_ENV": "production",
    "SITE_ORIGIN": "https://blog.example.com",
    "GITHUB_OWNER": "Nivek-Z",
    "GITHUB_REPO": "mob",
    "GITHUB_BRANCH": "main",
    "POSTS_DIRECTORY": "content/posts",
    "ACCESS_TEAM_DOMAIN": "replace.cloudflareaccess.com",
    "ACCESS_AUD": "replace-with-access-aud",
    "ADMIN_EMAILS": "replace@example.com",
    "INDEX_CACHE_SECONDS": "30",
    "MAX_MEDIA_BYTES": "1073741824"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MUTATIONS",
        "class_name": "BlogMutations"
      }
    ]
  },
  "exports": {
    "BlogMutations": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
