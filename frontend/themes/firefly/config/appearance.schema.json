{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "hero",
    "images",
    "stickers",
    "motion",
    "guide",
    "journey",
    "dialogue",
    "outro"
  ],
  "properties": {
    "hero": {
      "type": "object",
      "required": [
        "cover",
        "eyebrow",
        "occupation"
      ],
      "properties": {
        "cover": {
          "type": "string",
          "maxLength": 2000
        },
        "eyebrow": {
          "type": "string",
          "maxLength": 2000
        },
        "occupation": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },
    "images": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "maxLength": 2000
      }
    },
    "stickers": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "required": [
          "text",
          "x",
          "y",
          "rotation",
          "size"
        ],
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 100
          },
          "x": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "y": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "rotation": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "size": {
            "type": "number",
            "minimum": 8,
            "maximum": 100
          },
          "image": {
            "type": "string",
            "maxLength": 2000
          }
        }
      }
    },
    "motion": {
      "type": "object",
      "required": [
        "enabled",
        "rain",
        "ticker",
        "heroScrollVh",
        "storyScrollVh"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "rain": {
          "type": "boolean"
        },
        "ticker": {
          "type": "boolean"
        },
        "heroScrollVh": {
          "type": "number",
          "minimum": 100,
          "maximum": 700
        },
        "storyScrollVh": {
          "type": "number",
          "minimum": 100,
          "maximum": 1000
        }
      }
    },
    "journey": {
      "type": "object",
      "required": [
        "scenes",
        "wishes"
      ],
      "properties": {
        "scenes": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5
        },
        "wishes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    },
    "copy": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "maxLength": 4000
      }
    },
    "styles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": [
            "string",
            "number"
          ]
        }
      }
    }
  }
}
